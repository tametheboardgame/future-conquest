{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM"],
    "rootDir": "src/game",
    "outDir": ".test-dist",
    "noEmit": false
  },
  "include": ["src/game/**/*.ts"]
}
